/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  
  # Content Security Policy
  # Permissive policy to support any cloud storage provider and avoid breakage
  # ⚠️  Less restrictive for convenience - allows any HTTPS connection
  # Security maintained: blocks plugins (object-src), prevents external framing (frame-ancestors)
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' blob: data: https:; media-src 'self' blob: data: https:; connect-src 'self' https: wss:; frame-src 'self' https:; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests
